# ==============================================================================
# NostalgicVerse — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides.
# Never commit active private API keys or production secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database configuration
DATABASE_URL=./data/nostalgicverse.db

# Authentication
SESSION_SECRET=generate_a_secure_random_string_here

# Owner Account Setup
# This will be created on first boot if no owner exists
OWNER_USERNAME=Sufiyan_memon17
OWNER_INITIAL_PASSWORD=super_secret_deployment_password_change_me

# Internal API Secret for Automation & Ingestion Endpoints
# Used for protected endpoints (/api/internal/*)
INTERNAL_API_SECRET=nostalgicverse-dev-secret-2026

# Private AI Provider Selection
# Options: 'mock' (default offline zero-dependency), 'gemini', 'anthropic', 'openai'
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=3
AI_TEST_MODE=false
AI_DAILY_BUDGET_USD=5.00
AI_AUTOMATION_ENABLED=true

# AI Provider API Keys (Strictly Server-Side Only — Never Leaked to Browser)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Automation & Monitor Configurations
AUTOMATION_LOG_LEVEL=INFO
AUTOMATION_LOG_FILE=
IMAGE_AUDIT_BATCH_SIZE=15
IMAGE_AUDIT_TIMEOUT_MS=4000
