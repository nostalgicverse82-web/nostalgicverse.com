{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "siteName": "NostalgicVerse",
  "tagline": "The Games That Made History.",
  "siteUrl": "https://nostalgicverse.com",
  "version": "2026.1.0",
  "architectureType": "Zero-dependency static HTML5/CSS3/ES6+ (Offline build-time static exhibit generation)",
  "description": "A premium digital gaming museum, historical archive, preservation platform, and editorial publication dedicated to interactive entertainment history.",
  "canonicalCollectionRoutes": {
    "games": "/games/",
    "consoles": "/consoles/",
    "genres": "/genres/",
    "timeline": "/timeline/",
    "guides": "/guides/",
    "stories": "/blog/"
